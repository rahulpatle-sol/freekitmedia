# FreeKit Media — environment variables
#
# Contact form email notifications use Resend.
# Set these server-side variables in .env.local and in the production host.
#
# Contact form leads are saved to Google Sheets through a Google Apps Script
# web app. Configure its URL and shared token in .env.local and production.
#
# Rules for anyone adding secrets here:
# - Server-only secrets must NOT be prefixed with NEXT_PUBLIC_.
# - Never commit .env, .env.local, .env.production — they are git-ignored.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hello@freekitmedia.com
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=
